# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored — never commit real keys.
#
# The backend loads this file automatically on startup (python-dotenv).
# Real environment variables always take precedence over this file.

# Required for the AI Report LLM steps (extraction + authoring).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional model overrides. Defaults to REPORT_MODEL when unset.
# REPORT_MODEL=anthropic/claude-sonnet-5
# REPORT_MODEL_EXTRACT=anthropic/claude-sonnet-5
# REPORT_MODEL_AUTHOR=deepseek/deepseek-chat-v3-0324

# Max output tokens for the single consolidated section-authoring call
# (all Step 3 sections authored in one LLM call). Claude models cap at 64k
# output tokens; DeepSeek caps much lower (8k). When REPORT_MAX_TOKENS is
# unset, DeepSeek authoring models are auto-capped at 8k and everything else
# defaults to 64k (see sections._author_max_tokens()).
# REPORT_MAX_TOKENS=64000